        {
          "name": "01 - GET - Listar posts com paginação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?page=0&size=2&sort=titulo,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "2"
                },
                {
                  "key": "sort",
                  "value": "titulo,asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code é 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Retorna uma página de posts\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"content\");",
                  "    pm.expect(json.content).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Valida metadados da paginação\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"page\");",
                  "    pm.expect(json.page).to.have.property(\"size\");",
                  "    pm.expect(json.page).to.have.property(\"number\");",
                  "    pm.expect(json.page).to.have.property(\"totalElements\");",
                  "    pm.expect(json.page).to.have.property(\"totalPages\");",
                  "    pm.expect(json.page.size).to.eql(2);",
                  "    pm.expect(json.page.number).to.eql(0);",
                  "});",
                  "",
                  "pm.test(\"Valida estrutura do PostResponseDto\", function () {",
                  "    const json = pm.response.json();",
                  "    if (json.content.length > 0) {",
                  "        pm.expect(json.content[0]).to.have.property(\"id\");",
                  "        pm.expect(json.content[0]).to.have.property(\"autor\");",
                  "        pm.expect(json.content[0]).to.have.property(\"data\");",
                  "        pm.expect(json.content[0]).to.have.property(\"titulo\");",
                  "        pm.expect(json.content[0]).to.have.property(\"texto\");",
                  "        pm.expect(json.content[0]).to.have.property(\"comentarios\");",
                  "    }",
                  "});"
                ]
              }
            }
